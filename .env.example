# Скопируйте этот файл в .env и при необходимости поменяйте значения:
#   cp .env.example .env
#
# .env лежит в .gitignore и НИКОГДА не коммитится — в нём настоящие пароли.
# В репозиторий едет только этот пример, чтобы новый разработчик видел,
# какие переменные вообще нужны.
#
# Этот же файл читает docker compose (сам, автоматически) и приложение
# (через godotenv). Настройки базы описаны в одном месте.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=taskly
POSTGRES_USER=taskly
POSTGRES_PASSWORD=change-me-locally

# 127.0.0.1, а не localhost: docker пробрасывает порт только на IPv4,
# а localhost на многих системах резолвится в IPv6 ::1.
POSTGRES_HOST=127.0.0.1
# порт на вашей машине; внутри контейнера всегда 5432
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable

# ── HTTP ──────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s
